{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cravelens-origin-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cravelens.nishithp.page/api/*",
      "zone_name": "nishithp.page"
    },
    {
      "pattern": "cravelens.nishithp.page/socket.io/*",
      "zone_name": "nishithp.page"
    },
    {
      "pattern": "cravelens.nishithp.page/health",
      "zone_name": "nishithp.page"
    },
    {
      "pattern": "cravelens.nishithp.page/models/*",
      "zone_name": "nishithp.page"
    }
  ]
}

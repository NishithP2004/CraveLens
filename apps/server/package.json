{
  "name": "@cravelens/server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "for file in src/*.js; do node --check \"$file\"; done",

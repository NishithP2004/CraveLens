    "@langchain/openai": "^1.2.1",
    "@langfuse/core": "^5.9.1",
    "@langfuse/langchain": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@toon-format/toon": "^4.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jose": "^6.2.7",
    "langchain": "^1.2.24",
    "mongodb": "^6.17.0",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",

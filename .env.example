PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
MONGODB_URI=
MONGODB_DATABASE=cravelens
LOCAL_MODEL_DIRECTORY=
# Required for OAuth, device sessions, settings and browser inference routing.
REDIS_URL=redis://:change-me@localhost:6379/0
# 32-byte AES key encoded as 64 hex characters.
CREDENTIAL_ENCRYPTION_KEY=
# At least 32 random characters; used only to sign short-lived device access tokens.
DEVICE_SESSION_SIGNING_KEY=
AGENT_MODEL_PROVIDER=gemini
AGENT_MODEL_NAME=gemini-2.5-flash
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
# Default Ollama origin shown in the extension. Users can override it in Settings.
OLLAMA_BASE_URL=http://localhost:11434
# Optional. Langfuse tracing is enabled only when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional developer-only access token. Normal OAuth credentials are encrypted in Redis.
# Optional developer fallback. Normal users authenticate through the extension.
SWIGGY_MCP_ACCESS_TOKEN=
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
